# --- Uygulama ---
# Postgres bağlantı adresi (Dokploy: veritabanının "Internal Connection URL" değeri)
DATABASE_URL=postgres://kullanici:sifre@host:5432/qr
# Panele giriş şifren
ADMIN_PASSWORD=buraya-guclu-bir-sifre
# Oturum imzası için en az 32 karakter rastgele değer: openssl rand -hex 32
SESSION_SECRET=
# QR'ların içine yazılacak adres. Sonradan DEĞİŞTİRME, basılı kodlar bozulur.
PUBLIC_BASE_URL=https://qr.ornekdomain.com

# --- Sadece docker-compose ile kurulumda ---
POSTGRES_PASSWORD=buraya-veritabani-sifresi
